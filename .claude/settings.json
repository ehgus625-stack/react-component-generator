{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/secrets/**)",
      "Read(**/.secrets/**)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/.gnupg/**)",
      "Read(**/.docker/config.json)",
      "Read(**/service-account*.json)",
      "Read(**/*.tfvars)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.env)",
      "Edit(**/secrets/**)",
      "Edit(**/.secrets/**)",
      "Edit(**/*secret*)",
      "Edit(**/*credential*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/*.keystore)",
      "Edit(**/*.jks)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/id_ecdsa*)",
      "Edit(**/.npmrc)",
      "Edit(**/.netrc)",
      "Edit(**/.aws/**)",
      "Edit(**/.ssh/**)",
      "Edit(**/.gnupg/**)",
      "Edit(**/.docker/config.json)",
      "Edit(**/service-account*.json)",
      "Edit(**/*.tfvars)",
      "Bash(cat *.env*)",
      "Bash(cat *secret*)",
      "Bash(cat *credential*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep * *.env*)",
      "Bash(rg * *.env*)",
      "Bash(cp *.env* *)",
      "Bash(mv *.env* *)",
      "Bash(rm *.env*)",
      "Bash(source *.env*)",
      "Bash(. *.env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(set)",
      "Bash(cat *.pem*)",
      "Bash(cat *.key*)",
      "Bash(cat *id_rsa*)",
      "Bash(cat *id_ed25519*)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.aws/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-test.ts\"",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-reminder.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
